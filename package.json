{
  "name": "novopharma",
  "version": "1.1.0",
  "description": "NovoPharma V1 Windows desktop pharmacy billing and inventory application.",
  "main": "./out/main/index.js",
  "author": "NovoPharma",
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild:electron": "node scripts/ensure-electron-abi.js",
    "rebuild:node": "npm rebuild better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "start": "electron-vite preview",
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --config",
    "pack": "npm run build && electron-builder --dir --config",
    "test": "npm run rebuild:node && vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "electron-updater": "^6.8.9",
    "firebase": "^12.18.0",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "electron": "31.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "jsdom": "^24.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
